{
  "Comment": "Lambda Shutdown Pattern Analysis - Server-side Load Test Pipeline",
  "StartAt": "RecordStart",
  "States": {
    "RecordStart": {
      "Type": "Task",
      "Resource": "${LoadTestDriverFunctionArn}",
      "Comment": "Warm-up burst; its epochSeconds marks the analysis window start.",
      "Parameters": {
        "count": 1,
        "parallel": 1
      },
      "ResultPath": "$.startMarker",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "InitControl"
    },
    "InitControl": {
      "Type": "Pass",
      "Parameters": {
        "startEpoch.$": "$.startMarker.epochSeconds",
        "phase1Remaining": 12,
        "phase2Remaining": 72,
        "phase3Remaining": 36
      },
      "ResultPath": "$.control",
      "Next": "Phase1Choice"
    },
    "Phase1Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.control.phase1Remaining",
          "NumericGreaterThan": 0,
          "Next": "Phase1Burst"
        }
      ],
      "Default": "Phase2Choice"
    },
    "Phase1Burst": {
      "Type": "Task",
      "Resource": "${LoadTestDriverFunctionArn}",
      "Parameters": {
        "count": 40,
        "parallel": 20
      },
      "ResultPath": "$.lastBurst",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "Phase1Decrement"
    },
    "Phase1Decrement": {
      "Type": "Pass",
      "Parameters": {
        "startEpoch.$": "$.control.startEpoch",
        "phase1Remaining.$": "States.MathAdd($.control.phase1Remaining, -1)",
        "phase2Remaining.$": "$.control.phase2Remaining",
        "phase3Remaining.$": "$.control.phase3Remaining"
      },
      "ResultPath": "$.control",
      "Next": "Phase1Wait"
    },
    "Phase1Wait": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "Phase1Choice"
    },
    "Phase2Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.control.phase2Remaining",
          "NumericGreaterThan": 0,
          "Next": "Phase2Burst"
        }
      ],
      "Default": "Phase3Choice"
    },
    "Phase2Burst": {
      "Type": "Task",
      "Resource": "${LoadTestDriverFunctionArn}",
      "Parameters": {
        "count": 20,
        "parallel": 10
      },
      "ResultPath": "$.lastBurst",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "Phase2Decrement"
    },
    "Phase2Decrement": {
      "Type": "Pass",
      "Parameters": {
        "startEpoch.$": "$.control.startEpoch",
        "phase1Remaining.$": "$.control.phase1Remaining",
        "phase2Remaining.$": "States.MathAdd($.control.phase2Remaining, -1)",
        "phase3Remaining.$": "$.control.phase3Remaining"
      },
      "ResultPath": "$.control",
      "Next": "Phase2Wait"
    },
    "Phase2Wait": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "Phase2Choice"
    },
    "Phase3Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.control.phase3Remaining",
          "NumericGreaterThan": 0,
          "Next": "Phase3Burst"
        }
      ],
      "Default": "IdleWait"
    },
    "Phase3Burst": {
      "Type": "Task",
      "Resource": "${LoadTestDriverFunctionArn}",
      "Parameters": {
        "count": 40,
        "parallel": 20
      },
      "ResultPath": "$.lastBurst",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "Phase3Decrement"
    },
    "Phase3Decrement": {
      "Type": "Pass",
      "Parameters": {
        "startEpoch.$": "$.control.startEpoch",
        "phase1Remaining.$": "$.control.phase1Remaining",
        "phase2Remaining.$": "$.control.phase2Remaining",
        "phase3Remaining.$": "States.MathAdd($.control.phase3Remaining, -1)"
      },
      "ResultPath": "$.control",
      "Next": "Phase3Wait"
    },
    "Phase3Wait": {
      "Type": "Wait",
      "Seconds": 5,
      "Next": "Phase3Choice"
    },
    "IdleWait": {
      "Type": "Wait",
      "Seconds": 900,
      "Next": "RecordEnd"
    },
    "RecordEnd": {
      "Type": "Task",
      "Resource": "${LoadTestDriverFunctionArn}",
      "Comment": "Marker burst; its epochSeconds marks the analysis window end.",
      "Parameters": {
        "count": 1,
        "parallel": 1
      },
      "ResultPath": "$.endMarker",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2
        }
      ],
      "Next": "StartRecommendationPipeline"
    },
    "StartRecommendationPipeline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${RecommendationPipelineArn}",
        "Input": {
          "startTime.$": "$.control.startEpoch",
          "endTime.$": "$.endMarker.epochSeconds"
        }
      },
      "ResultPath": "$.recommendation",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.recommendationError",
          "Next": "Done"
        }
      ],
      "End": true
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
